{
  "name": "tu-design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config",
    "publish:pkg": "pnpm -r --filter '@tu-design/*' publish --no-git-checks",
    "release:vue": "bumpp --tag \"@tu-design/vue@{version}\" --commit \"chore: 🔖 release @tu-design/vue@{version}\"",
    "release:cli": "bumpp --tag \"@tu-design/cli@{version}\" --commit \"chore: 🔖 release @tu-design/cli@{version}\""
  },
  "devDependencies": {
    "bumpp": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.6.0"
}
