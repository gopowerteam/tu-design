{
  "name": "tu-design",
  "version": "0.5.8",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config",
    "publish:pkg": "pnpm -r --filter '@tu-design/*' publish --no-git-checks",
    "docs": "pnpm --filter @tu-design/docs dev",
    "release": "bumpp"
  },
  "devDependencies": {
    "@tu-design/config-lint": "workspace:*",
    "bumpp": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.6.0"
}
