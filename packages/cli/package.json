{
  "name": "@tu-design/cli",
  "version": "0.1.1",
  "description": "tu-design CLI：初始化并按 registry 分发组件源码到用户项目（shadcn 模式）。",
  "keywords": [
    "cli",
    "registry",
    "scaffold",
    "shadcn",
    "vue"
  ],
  "homepage": "https://github.com/gopowerteam/tu-design#readme",
  "bugs": {
    "url": "https://github.com/gopowerteam/tu-design/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopowerteam/tu-design.git"
  },
  "bin": {
    "tu-design": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run build",
    "build": "vp pack && tsx scripts/fix-bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test --run"
  },
  "dependencies": {
    "@tu-design/vue": "workspace:*",
    "commander": "catalog:",
    "package-manager-detector": "catalog:",
    "picocolors": "catalog:",
    "prompts": "catalog:"
  },
  "devDependencies": {
    "@types/prompts": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
