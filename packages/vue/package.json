{
  "name": "@tu-design/vue",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run build",
    "build": "vp run generate:registry && vp pack && rm -rf dist/registry/vue && mkdir -p dist/registry/vue && cp -r registry/vue/. dist/registry/vue/",
    "generate:registry": "tsx scripts/generate-registry.ts && vp fmt registry",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test --run"
  },
  "dependencies": {
    "@ark-ui/vue": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  }
}
