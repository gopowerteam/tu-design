{
  "name": "@tu-design/vue",
  "version": "0.1.0",
  "description": "shadcn 风格的 Vue 3 组件库：Tailwind CSS v4 主题 + Ark UI 原语，CLI 分发组件源码。",
  "keywords": [
    "components",
    "registry",
    "shadcn",
    "tailwindcss",
    "ui",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/gopowerteam/tu-design#readme",
  "bugs": {
    "url": "https://github.com/gopowerteam/tu-design/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopowerteam/tu-design.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "vp run build",
    "build": "vp run generate:registry && vp pack && tsx scripts/copy-registry.ts",
    "generate:registry": "tsx scripts/generate-registry.ts && vp fmt registry",
    "typecheck": "vue-tsc --noEmit",
    "test": "vp test --run"
  },
  "dependencies": {
    "@ark-ui/vue": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "^8.0.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  }
}
