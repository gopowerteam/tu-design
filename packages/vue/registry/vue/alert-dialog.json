{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert-dialog",
  "version": "0.5.19",
  "type": "registry:ui",
  "description": "确认弹窗单组件：v-model:open 控制显隐，title/description 传文案，@confirm/@cancel 处理确认与取消；确认处理器返回 Promise 时按钮进入 loading 并锁定 ESC/遮罩关闭，resolve 自动关闭、reject 保持打开；内容节点为 role=alertdialog。",
  "registryDependencies": ["button", "utils", "overlay-shared"],
  "dependencies": ["@ark-ui/vue@^5.40.0"],
  "files": [
    {
      "path": "alert-dialog/AlertDialog.vue",
      "type": "registry:component",
      "target": "components/ui/alert-dialog/AlertDialog.vue",
      "content": "<script setup lang=\"ts\">\nimport type { PropType } from \"vue\";\nimport { computed, getCurrentInstance, useAttrs } from \"vue\";\nimport { Dialog as ArkDialog } from \"@ark-ui/vue/dialog\";\nimport { cn } from \"@/lib/utils\";\nimport { Button } from \"@/components/ui/button\";\nimport { useConfirmPending } from \"../overlay-shared/useConfirmPending\";\nimport { useControlledBoolean } from \"../overlay-shared/useControlledBoolean\";\nimport { useOverlayIds } from \"../overlay-shared/useOverlayIds\";\nimport { useOverlayScrollLock } from \"../overlay-shared/useOverlayScrollLock\";\nimport { overlayPreventScroll } from \"../overlay-shared/useSandboxOverlay\";\n\nconst attrs = useAttrs();\n\n// ids 全量覆盖（无冒号）：规避 wujie patch getElementById 对 zag 缺省冒号 id 的\n// SyntaxError 刷屏（详注见 useOverlayIds）；复用 dialog machine，parts 同 Dialog\nconst { ids: rootIds } = useOverlayIds(attrs, {\n  primary: \"content\",\n  parts: [\"content\", \"title\", \"description\", \"trigger\", \"closeTrigger\", \"positioner\", \"backdrop\"],\n});\n\n// 用运行时 props 显式 default: undefined：Boolean prop 缺省时 Vue 会 cast 成 false，\n// 导致无法区分「未传（非受控）」与「传了 false（受控关闭）」。与 Dialog.vue 同款约定。\nconst props = defineProps({\n  /** 受控开关（配合 v-model:open）；不传时为非受控，由内部状态管理 */\n  open: { type: Boolean as PropType<boolean | undefined>, default: undefined },\n  /** 标题文案（#title 插槽优先） */\n  title: { type: String, required: true },\n  /** 描述文案（#description 插槽优先，可不传） */\n  description: { type: String, default: undefined },\n  /** 确认按钮文案 */\n  confirmText: { type: String, default: \"确定\" },\n  /** 取消按钮文案 */\n  cancelText: { type: String, default: \"取消\" },\n  /** 确认按钮使用 destructive 语义色（危险操作场景） */\n  destructive: { type: Boolean, default: false },\n});\n\nconst emit = defineEmits<{\n  \"update:open\": [open: boolean];\n  confirm: [];\n  cancel: [];\n}>();\n\n// 对 Root 恒走受控模式（open 恒为布尔）：非受控语义由内部 ref 实现，与 Dialog.vue 一致。\n// setup 期间捕获实例：getCurrentInstance 仅在 setup/生命周期内有效，事件回调里返回 null。\nconst instance = getCurrentInstance();\nconst { isOpen, setOpen } = useControlledBoolean({\n  controlled: () => props.open,\n  onChange: (open) => emit(\"update:open\", open),\n});\n\n// overlay 滚动锁契约（issue #5，语义 B 拓扑闸在 overlayContract 内）；\n// isModal 仅在 isOpen 转换回调内求值（冻结语义，不 watch attrs）\nuseOverlayScrollLock(isOpen, () => attrs.modal !== false && attrs.modal !== \"false\");\n\nfunction handleUpdate(open: boolean) {\n  // pending 期间忽略一切关闭请求（走受控桥拒绝同步，弹窗保持打开）——\n  // 与 Popconfirm 同款锁定方案；Root 仍保留 :close-on-escape/:close-on-interact-outside 双保险\n  if (!open && loading.value) return;\n  setOpen(open);\n}\n\n/** 关闭弹窗：走受控桥把 open 置 false，退出动画/焦点还原由 zag 处理 */\nfunction close() {\n  handleUpdate(false);\n}\n\n// 确认 Promise pending 时锁定关闭通道（ESC/遮罩/取消按钮全部锁死），只能等 Promise 落定\nconst { loading, handleConfirm, handleCancel } = useConfirmPending({\n  instance,\n  emitConfirm: () => emit(\"confirm\"),\n  emitCancel: () => emit(\"cancel\"),\n  close,\n});\n\n// 面板样式：复用 Dialog 的内容面板类（含 --dialog 模态表面位，issue #2），宽度收窄为 sm:max-w-md 的确认弹窗尺度\n// 进出场动画与 Dialog.vue 保持同款（fade + zoom-95 + 上方 8px 落位，200ms，进 ease-out 出 ease-in）\nconst contentClass = computed(() =>\n  cn(\n    \"bg-dialog text-dialog-foreground data-[state=open]:animate-in data-[state=closed]:animate-out fixed left-1/2 top-1/2 z-[var(--z-modal,60)] grid w-full max-w-[calc(100%-2rem)] -translate-x-1/2 -translate-y-1/2 gap-4 rounded-lg border p-6 shadow-lg duration-200 data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[state=closed]:slide-out-to-top-2 data-[state=open]:slide-in-from-top-2 data-[state=closed]:ease-in data-[state=open]:ease-out sm:max-w-md\",\n  ),\n);\n\n// 滚动锁沙箱降级（wujie graft 下禁用，机制与论证见 overlayPreventScroll / issue #4）\nconst preventScroll = overlayPreventScroll();\n</script>\n\n<template>\n  <ArkDialog.Root\n    :ids=\"rootIds\"\n    :open=\"isOpen\"\n    :prevent-scroll=\"preventScroll\"\n    :close-on-escape=\"!loading\"\n    :close-on-interact-outside=\"!loading\"\n    @update:open=\"handleUpdate\"\n  >\n    <ArkDialog.Backdrop\n      class=\"fixed inset-0 z-[var(--z-modal,60)] bg-black/50 duration-200 data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:ease-in data-[state=open]:ease-out\"\n    />\n    <ArkDialog.Positioner\n      class=\"fixed inset-0 z-[var(--z-modal,60)] flex items-center justify-center p-4\"\n    >\n      <!-- role=\"alertdialog\"：覆盖 Ark Content 默认 role=\"dialog\"，补偿无上游 AlertDialog 原语的角色语义 -->\n      <ArkDialog.Content :class=\"contentClass\" role=\"alertdialog\" aria-modal=\"true\">\n        <div class=\"flex flex-col gap-2 text-center sm:text-left\">\n          <ArkDialog.Title class=\"text-lg font-semibold leading-none tracking-tight\">\n            <slot name=\"title\">{{ props.title }}</slot>\n          </ArkDialog.Title>\n          <ArkDialog.Description\n            v-if=\"$slots.description || props.description\"\n            class=\"text-sm text-muted-foreground\"\n          >\n            <slot name=\"description\">{{ props.description }}</slot>\n          </ArkDialog.Description>\n        </div>\n\n        <!-- 默认插槽：补充正文（可选） -->\n        <slot />\n\n        <!-- 底部操作区：取消 outline，确认按 destructive 切换语义色；pending 时确认钮转 loading -->\n        <div class=\"flex flex-col-reverse gap-2 sm:flex-row sm:justify-end\">\n          <Button variant=\"outline\" :disabled=\"loading\" @click=\"handleCancel\">\n            {{ props.cancelText }}\n          </Button>\n          <Button\n            :variant=\"props.destructive ? 'destructive' : 'default'\"\n            :disabled=\"loading\"\n            @click=\"handleConfirm\"\n          >\n            <svg\n              v-if=\"loading\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n              class=\"size-4 animate-spin\"\n              aria-hidden=\"true\"\n            >\n              <path d=\"M21 12a9 9 0 1 1-6.219-8.56\" />\n            </svg>\n            {{ props.confirmText }}\n          </Button>\n        </div>\n      </ArkDialog.Content>\n    </ArkDialog.Positioner>\n  </ArkDialog.Root>\n</template>\n"
    },
    {
      "path": "alert-dialog/index.ts",
      "type": "registry:lib",
      "target": "components/ui/alert-dialog/index.ts",
      "content": "export { default as AlertDialog } from \"./AlertDialog.vue\";\n"
    }
  ]
}
