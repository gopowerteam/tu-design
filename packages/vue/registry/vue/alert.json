{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "alert",
  "type": "registry:ui",
  "description": "语义化警示条，支持五种变体、内置图标与可关闭交互。",
  "registryDependencies": ["utils"],
  "dependencies": ["class-variance-authority@^0.7.1"],
  "files": [
    {
      "path": "alert/Alert.vue",
      "type": "registry:component",
      "target": "components/ui/alert/Alert.vue",
      "content": "<script setup lang=\"ts\">\nimport { computed, useSlots } from \"vue\";\nimport { cn } from \"@/lib/utils\";\nimport { alertIconVariants, alertVariants, type AlertVariants } from \"./index\";\n\ninterface Props {\n  title?: string;\n  description?: string;\n  variant?: AlertVariants[\"variant\"];\n  closable?: boolean;\n  showIcon?: boolean;\n  class?: string;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  title: \"\",\n  description: undefined,\n  variant: \"default\",\n  closable: false,\n  showIcon: true,\n  class: undefined,\n});\n\nconst emit = defineEmits<{ close: [] }>();\n\nconst slots = useSlots();\n\nconst visible = defineModel<boolean>({ default: true });\n\nconst role = computed(() => (props.variant === \"error\" ? \"alert\" : \"status\"));\n\nconst icons: Record<string, string> = {\n  default: \"M12 16v-4m0-4h.01M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z\",\n  info: \"M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\",\n  success: \"M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4 12 14.01l-3-3\",\n  warning:\n    \"M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z\",\n  error: \"M12 8v4m0 4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z\",\n};\n\nconst iconPath = computed(() => icons[props.variant ?? \"default\"] ?? icons.default);\n\nfunction onClose() {\n  visible.value = false;\n  emit(\"close\");\n}\n</script>\n\n<template>\n  <div\n    v-if=\"visible\"\n    :role=\"role\"\n    :class=\"cn(alertVariants({ variant: props.variant }), props.class)\"\n  >\n    <slot name=\"icon\">\n      <svg\n        v-if=\"props.showIcon\"\n        xmlns=\"http://www.w3.org/2000/svg\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n        :class=\"cn(alertIconVariants({ variant: props.variant }))\"\n      >\n        <path :d=\"iconPath\" />\n      </svg>\n    </slot>\n\n    <div class=\"min-w-0 flex-1\">\n      <div v-if=\"props.title || slots.title\" class=\"font-medium leading-snug\">\n        <slot name=\"title\">{{ props.title }}</slot>\n      </div>\n      <div\n        v-if=\"props.description || slots.default\"\n        :class=\"\n          cn(\n            'text-sm leading-relaxed',\n            (props.title || slots.title) && 'text-muted-foreground mt-1',\n          )\n        \"\n      >\n        <slot>{{ props.description }}</slot>\n      </div>\n    </div>\n\n    <slot name=\"close\">\n      <button\n        v-if=\"props.closable\"\n        type=\"button\"\n        aria-label=\"关闭\"\n        class=\"shrink-0 rounded-sm opacity-60 transition-opacity hover:opacity-100 focus-visible:outline-2 focus-visible:outline-ring -m-1 p-1\"\n        @click=\"onClose\"\n      >\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n          class=\"size-4\"\n        >\n          <path d=\"M18 6 6 18M6 6l12 12\" />\n        </svg>\n      </button>\n    </slot>\n  </div>\n</template>\n"
    },
    {
      "path": "alert/index.ts",
      "type": "registry:component",
      "target": "components/ui/alert/index.ts",
      "content": "import { cva, type VariantProps } from \"class-variance-authority\";\n\nexport { default as Alert } from \"./Alert.vue\";\n\nexport const alertVariants = cva(\n  \"relative w-full rounded-lg border px-4 py-3 text-sm flex gap-3 items-start\",\n  {\n    variants: {\n      variant: {\n        default: \"border-border bg-card text-card-foreground\",\n        info: \"border-[color-mix(in_oklab,var(--color-info)_35%,transparent)] bg-[color-mix(in_oklab,var(--color-info)_10%,transparent)] text-foreground\",\n        success:\n          \"border-[color-mix(in_oklab,var(--color-success)_35%,transparent)] bg-[color-mix(in_oklab,var(--color-success)_10%,transparent)] text-foreground\",\n        warning:\n          \"border-[color-mix(in_oklab,var(--color-warning)_35%,transparent)] bg-[color-mix(in_oklab,var(--color-warning)_10%,transparent)] text-foreground\",\n        error:\n          \"border-[color-mix(in_oklab,var(--color-destructive)_35%,transparent)] bg-[color-mix(in_oklab,var(--color-destructive)_10%,transparent)] text-foreground\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n    },\n  },\n);\n\nexport type AlertVariants = VariantProps<typeof alertVariants>;\n\nexport const alertIconVariants = cva(\"size-4 shrink-0 mt-0.5\", {\n  variants: {\n    variant: {\n      default: \"text-foreground\",\n      info: \"text-info\",\n      success: \"text-success\",\n      warning: \"text-warning\",\n      error: \"text-destructive\",\n    },\n  },\n  defaultVariants: {\n    variant: \"default\",\n  },\n});\n"
    }
  ]
}
