{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "spin",
  "type": "registry:ui",
  "description": "加载中旋转指示器，支持独立 spinner 与包裹内容（半透明遮罩）两种形态。",
  "registryDependencies": ["utils"],
  "dependencies": ["class-variance-authority@^0.7.1"],
  "files": [
    {
      "path": "spin/Spin.vue",
      "type": "registry:component",
      "target": "components/ui/spin/Spin.vue",
      "content": "<script setup lang=\"ts\">\nimport { cva } from \"class-variance-authority\";\nimport { computed, useSlots } from \"vue\";\nimport { cn } from \"@/lib/utils\";\n\nconst props = withDefaults(\n  defineProps<{\n    /** spinner 尺寸 */\n    size?: \"sm\" | \"default\" | \"lg\";\n    /** 是否处于加载中 */\n    spinning?: boolean;\n    /** 无障碍标签（role=\"status\" 的 aria-label） */\n    label?: string;\n    class?: string;\n  }>(),\n  {\n    size: \"default\",\n    spinning: true,\n    label: \"加载中\",\n  },\n);\n\nconst spinVariants = cva(\"text-primary\", {\n  variants: {\n    size: {\n      sm: \"size-4\",\n      default: \"size-6\",\n      lg: \"size-8\",\n    },\n  },\n  defaultVariants: {\n    size: \"default\",\n  },\n});\n\n// aria-busy + aria-label 只挂在 role=\"status\" 状态元素上（避免根/状态元素双重播报）；\n// 包裹态（默认插槽有内容）渲染内容 + 半透明遮罩，独立态仅渲染 spinner；\n// 包裹态 spinning 时根元素置 inert，阻止被遮罩内容聚焦/交互\nconst slots = useSlots();\nconst hasContent = computed(() => !!slots.default);\n</script>\n\n<template>\n  <div\n    v-if=\"hasContent || spinning\"\n    :class=\"cn(hasContent ? 'relative' : 'inline-flex', props.class)\"\n    :inert=\"hasContent && spinning\"\n  >\n    <slot v-if=\"hasContent\" />\n\n    <div\n      v-if=\"spinning\"\n      role=\"status\"\n      :aria-busy=\"spinning\"\n      :aria-label=\"label\"\n      :class=\"\n        hasContent\n          ? 'absolute inset-0 z-10 flex items-center justify-center rounded-[inherit] bg-background/60'\n          : 'flex'\n      \"\n    >\n      <svg\n        :class=\"cn('animate-spin', spinVariants({ size }))\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        aria-hidden=\"true\"\n      >\n        <circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"3\" class=\"opacity-25\" />\n        <path\n          d=\"M22 12a10 10 0 0 0-10-10\"\n          stroke=\"currentColor\"\n          stroke-width=\"3\"\n          stroke-linecap=\"round\"\n        />\n      </svg>\n    </div>\n  </div>\n</template>\n"
    },
    {
      "path": "spin/index.ts",
      "type": "registry:component",
      "target": "components/ui/spin/index.ts",
      "content": "export { default as Spin } from \"./Spin.vue\";\n"
    }
  ]
}
