{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "calendar",
  "type": "registry:ui",
  "description": "日历（TCalendar）：紧凑日历卡。Picker 弹层内为 embedded 内嵌形态（TDatePicker/TDateRangePicker 自动挂靠，纯卡片内核）；独立使用即 standalone 独立形态（自带日历状态与 v-model，恒开展示）。",
  "registryDependencies": ["utils", "date-shared"],
  "dependencies": ["@ark-ui/vue@^5.39.2"],
  "files": [
    {
      "path": "calendar/Calendar.vue",
      "type": "registry:component",
      "target": "components/ui/calendar/Calendar.vue",
      "content": "<script setup lang=\"ts\">\nimport type { DateValue } from \"@ark-ui/vue/date-picker\";\nimport { DatePicker as ArkDatePicker } from \"@ark-ui/vue/date-picker\";\nimport type { PropType } from \"vue\";\nimport { computed, inject, ref } from \"vue\";\nimport { CALENDAR_IN_PICKER, formatIsoDate, parseIsoDate } from \"../date-shared/shared\";\nimport CalendarBody from \"./CalendarBody.vue\";\n\nconst props = defineProps({\n  /** 视图形态：day=日网格（可切月/年）；standalone 时 month/year 同时派生视图锁定 */\n  mode: { type: String as PropType<\"day\" | \"month\" | \"year\">, default: \"day\" },\n  /** 日视图并排月数 */\n  numOfMonths: { type: Number, default: 1 },\n  /** 受控值（\"yyyy-MM-dd\"）；仅 standalone 独立形态生效，embedded 值归宿主 Picker */\n  modelValue: { type: String as PropType<string | null | undefined>, default: undefined },\n  /** 非受控初值（仅 standalone） */\n  defaultValue: { type: String, default: undefined },\n  /** 可选下界（\"yyyy-MM-dd\"，含当日；仅 standalone） */\n  min: { type: String, default: undefined },\n  /** 可选上界（\"yyyy-MM-dd\"，含当日；仅 standalone） */\n  max: { type: String, default: undefined },\n  /** 不可选日期谓词（参数为 ark 的 DateValue；仅 standalone） */\n  isDateUnavailable: {\n    type: Function as PropType<(date: DateValue) => boolean>,\n    default: undefined,\n  },\n  /** 文案与周起点跟随 locale（仅 standalone；embedded 随宿主 Picker） */\n  locale: { type: String, default: \"zh-CN\" },\n});\n\nconst emit = defineEmits<{\n  \"update:modelValue\": [value: string | null];\n}>();\n\n// 双形态探测：Picker 弹层内（宿主 provide）为 embedded 内嵌形态（纯卡片内核）；独立使用为 standalone 独立形态（自建 Root）\nconst standalone = !inject(CALENDAR_IN_PICKER, false);\n\n// standalone 时 month/year 形态即语义 → 派生视图锁定（day 不锁，保留月/年切换）\nconst viewLock = computed(() => (props.mode === \"day\" ? undefined : props.mode));\n\n// —— 受控桥（DatePicker 同款简化版，单值无 mirror 需求）——\nconst internalValue = ref<string | null>(props.defaultValue ?? null);\nconst selected = computed(() => {\n  const raw = props.modelValue !== undefined ? props.modelValue : internalValue.value;\n  return parseIsoDate(raw ?? \"\");\n});\n// zag value 为 DateValue[] 数组形态，单选语义收敛为 [date] | []\nconst rootValue = computed<DateValue[]>(() => (selected.value ? [selected.value] : []));\n\nconst minDate = computed(() => parseIsoDate(props.min ?? \"\"));\nconst maxDate = computed(() => parseIsoDate(props.max ?? \"\"));\n\nfunction handleValueUpdate(next: DateValue[]) {\n  const value = next[0] ? formatIsoDate(next[0]) : null;\n  internalValue.value = value;\n  emit(\"update:modelValue\", value);\n}\n</script>\n\n<template>\n  <!--\n    standalone 独立形态：自建 Root。:open=\"true\" 恒开——独立卡片没有输入框/触发钮\n    去打开弹层，不恒开则 Content hidden 整卡不可见。沿用已验证的 Root > Content 直渲形态\n    （无 Positioner：卡片非浮层，就地渲染）。\n    外层 div 承接 attrs（Ark Root 不透传 attrs，实测 class/id 会丢）；w-fit 收缩包裹卡片宽度。\n  -->\n  <div v-if=\"standalone\" class=\"w-fit\">\n    <ArkDatePicker.Root\n      :model-value=\"rootValue\"\n      :open=\"true\"\n      :num-of-months=\"props.numOfMonths\"\n      :min-view=\"viewLock\"\n      :max-view=\"viewLock\"\n      :min=\"minDate\"\n      :max=\"maxDate\"\n      :is-date-unavailable=\"props.isDateUnavailable\"\n      :locale=\"props.locale\"\n      @update:model-value=\"handleValueUpdate\"\n    >\n      <ArkDatePicker.Content>\n        <CalendarBody :mode=\"props.mode\" :num-of-months=\"props.numOfMonths\" />\n      </ArkDatePicker.Content>\n    </ArkDatePicker.Root>\n  </div>\n\n  <!-- embedded 内嵌形态：宿主 Picker 的 Root 供能，纯卡片内核 -->\n  <CalendarBody v-else :mode=\"props.mode\" :num-of-months=\"props.numOfMonths\" />\n</template>\n"
    },
    {
      "path": "calendar/CalendarBody.vue",
      "type": "registry:component",
      "target": "components/ui/calendar/CalendarBody.vue",
      "content": "<script setup lang=\"ts\">\nimport { DatePicker as ArkDatePicker } from \"@ark-ui/vue/date-picker\";\nimport type { DateValue } from \"@ark-ui/vue/date-picker\";\nimport { computed } from \"vue\";\nimport { cn } from \"@/lib/utils\";\nimport CalendarNav from \"./CalendarNav.vue\";\n\nconst props = withDefaults(\n  defineProps<{\n    /** 渲染裁剪：渲染哪个视图块；「锁定视图」由 picker Root 的 minView/maxView 承担（卡片不持 Root） */\n    mode?: \"day\" | \"month\" | \"year\";\n    /** 日视图并排月数 */\n    numOfMonths?: number;\n  }>(),\n  { mode: \"day\", numOfMonths: 1 },\n);\n\n// —— 卡片视觉常量（打磨单点：视觉调整只改本文件）——\nconst cardCls = computed(() => [props.numOfMonths > 1 ? \"w-[40rem]\" : \"w-80\", \"p-4\"]);\n// 导航条（ViewControl/Prev/Next/ViewTrigger）样式常量已迁 calendar/CalendarNav.vue\n// 日视图双层格子（naive 式「命中大、视觉小」）：\n// trigger = 全格命中区 + range 无缝条带层（primary/10；行首行尾圆角由模板按列位补）\n// dot     = 24px 视觉圆点层，hover/选中/今天/禁用色全落此层（经 group-* 读取 trigger 状态）\n// outside-view = Card 自标「格不属于本表锚点月」，range/选中视觉在补位格上失效，\n//                且补位格不可点击（naive excluded 语义：仅作日期连续性视觉提示）\nconst dayTriggerCls =\n  \"group relative flex h-8 w-full cursor-pointer items-center justify-center outline-none data-[outside-view]:pointer-events-none data-[disabled]:pointer-events-none data-[in-range]:not-data-[outside-view]:not-data-[range-start]:not-data-[range-end]:bg-primary/10 data-[range-start]:rounded-l-[3px] data-[range-end]:rounded-r-[3px]\";\nconst dayDotCls =\n  \"flex size-6 items-center justify-center rounded-[3px] text-sm transition-colors group-hover:bg-accent group-data-[focus]:not-group-data-[outside-view]:bg-accent group-data-[selected]:not-group-data-[outside-view]:bg-primary group-data-[selected]:not-group-data-[outside-view]:font-medium group-data-[selected]:not-group-data-[outside-view]:text-primary-foreground group-data-[today]:not-group-data-[selected]:text-primary group-data-[today]:not-group-data-[selected]:font-semibold group-data-[unavailable]:line-through group-data-[unavailable]:opacity-30 group-data-[disabled]:opacity-40 group-data-[outside-view]:opacity-30\";\n// 月/年视图单层格子（沿用小圆角语言；range 变体单选无副作用，此处不涉及）\nconst cellCls =\n  \"flex h-9 w-full items-center justify-center rounded-[3px] text-sm outline-none hover:bg-accent data-[selected]:bg-primary data-[selected]:font-medium data-[selected]:text-primary-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-40\";\n// table-fixed：7 列日视图 / 4 列月年视图均分列宽，表头与内容同走原生 table 布局\nconst tableCls = \"w-full min-w-0 flex-1 table-fixed border-collapse\";\nconst headCellCls =\n  \"text-muted-foreground h-8 border-x-0! border-t-0! border-b border-border p-0! text-center! text-xs! align-middle font-normal whitespace-nowrap\";\nconst bodyCellCls = \"border-0! p-0! text-center\";\n// 宿主斑马线防御：VitePress .vp-doc tr:nth-child(2n) 背景污染（与 range 条带浅色撞车）\nconst rowCls = \"bg-transparent!\";\n\n// —— 补位格自标记（ zag data-outside-range 是「整机可见范围」语义，双月时相邻月表内\n// 的上月尾/下月头格不带它，range/选中视觉会跨表重复高亮；Card 按锚点月自行判定）——\ntype TableCtx = {\n  getOffset(duration: { months: number }): { visibleRange: { start: DateValue } };\n};\n\n/** 表 i 的锚点月起点（zag getOffset({months: i-1}).visibleRange.start） */\nfunction tableAnchor(context: TableCtx, i: number): DateValue | undefined {\n  return context.getOffset({ months: i - 1 })?.visibleRange?.start;\n}\n\n/** 格子日期不属于锚点月（年或月不一致）即为补位格 */\nfunction isOutsideView(day: DateValue, anchor: DateValue | undefined): boolean {\n  return !!anchor && (day.year !== anchor.year || day.month !== anchor.month);\n}\n</script>\n\n<template>\n  <div :class=\"cn(cardCls)\">\n    <template v-if=\"mode === 'day'\">\n      <ArkDatePicker.View :view=\"'day'\">\n        <!-- day 视图导航条在 View 内：viewProps=day → GOTO.NEXT=focusNextPage（翻月） -->\n        <CalendarNav view=\"day\" />\n        <ArkDatePicker.Context v-slot=\"context\">\n          <div class=\"flex gap-6\">\n            <ArkDatePicker.Table v-for=\"i in numOfMonths\" :key=\"i\" :class=\"tableCls\">\n              <ArkDatePicker.TableHead>\n                <ArkDatePicker.TableRow :class=\"rowCls\">\n                  <ArkDatePicker.TableHeader\n                    v-for=\"(weekDay, id) in context.weekDays\"\n                    :key=\"id\"\n                    :class=\"headCellCls\"\n                  >\n                    {{ weekDay.narrow }}\n                  </ArkDatePicker.TableHeader>\n                </ArkDatePicker.TableRow>\n              </ArkDatePicker.TableHead>\n              <ArkDatePicker.TableBody>\n                <ArkDatePicker.TableRow\n                  :class=\"rowCls\"\n                  v-for=\"(week, id) in context.getOffset({ months: i - 1 }).weeks\"\n                  :key=\"id\"\n                >\n                  <ArkDatePicker.TableCell\n                    v-for=\"(day, colIdx) in week\"\n                    :key=\"day.toString()\"\n                    :value=\"day\"\n                    :class=\"bodyCellCls\"\n                  >\n                    <ArkDatePicker.TableCellTrigger\n                      :class=\"\n                        cn(\n                          dayTriggerCls,\n                          colIdx === 0 && 'rounded-l-[3px]',\n                          colIdx === week.length - 1 && 'rounded-r-[3px]',\n                        )\n                      \"\n                      :data-outside-view=\"\n                        isOutsideView(day, tableAnchor(context, i)) ? '' : undefined\n                      \"\n                    >\n                      <span :class=\"dayDotCls\">{{ day.day }}</span>\n                    </ArkDatePicker.TableCellTrigger>\n                  </ArkDatePicker.TableCell>\n                </ArkDatePicker.TableRow>\n              </ArkDatePicker.TableBody>\n            </ArkDatePicker.Table>\n          </div>\n        </ArkDatePicker.Context>\n      </ArkDatePicker.View>\n\n      <ArkDatePicker.View :view=\"'month'\">\n        <!-- 切换视图导航条也在 View 内：DatePicker 切月视图后 GOTO.NEXT=focusNextYear（修复 backlog） -->\n        <CalendarNav view=\"month\" />\n        <ArkDatePicker.Context v-slot=\"context\">\n          <ArkDatePicker.Table :class=\"tableCls\">\n            <ArkDatePicker.TableBody>\n              <ArkDatePicker.TableRow\n                :class=\"rowCls\"\n                v-for=\"(monthsRow, id) in context.getMonthsGrid({ columns: 4, format: 'short' })\"\n                :key=\"id\"\n              >\n                <ArkDatePicker.TableCell\n                  v-for=\"month in monthsRow\"\n                  :key=\"month.value.toString()\"\n                  :value=\"month.value\"\n                  :class=\"bodyCellCls\"\n                >\n                  <ArkDatePicker.TableCellTrigger :class=\"cn(cellCls)\">\n                    {{ month.label }}\n                  </ArkDatePicker.TableCellTrigger>\n                </ArkDatePicker.TableCell>\n              </ArkDatePicker.TableRow>\n            </ArkDatePicker.TableBody>\n          </ArkDatePicker.Table>\n        </ArkDatePicker.Context>\n      </ArkDatePicker.View>\n\n      <ArkDatePicker.View :view=\"'year'\">\n        <CalendarNav view=\"year\" />\n        <ArkDatePicker.Context v-slot=\"context\">\n          <ArkDatePicker.Table :class=\"tableCls\">\n            <ArkDatePicker.TableBody>\n              <ArkDatePicker.TableRow\n                :class=\"rowCls\"\n                v-for=\"(yearsRow, id) in context.getYearsGrid({ columns: 4 })\"\n                :key=\"id\"\n              >\n                <ArkDatePicker.TableCell\n                  v-for=\"year in yearsRow\"\n                  :key=\"year.value.toString()\"\n                  :value=\"year.value\"\n                  :class=\"bodyCellCls\"\n                >\n                  <ArkDatePicker.TableCellTrigger :class=\"cn(cellCls)\">\n                    {{ year.label }}\n                  </ArkDatePicker.TableCellTrigger>\n                </ArkDatePicker.TableCell>\n              </ArkDatePicker.TableRow>\n            </ArkDatePicker.TableBody>\n          </ArkDatePicker.Table>\n        </ArkDatePicker.Context>\n      </ArkDatePicker.View>\n    </template>\n\n    <ArkDatePicker.View v-else-if=\"mode === 'month'\" :view=\"'month'\">\n      <!-- 导航条必须在 View 子树内：Prev/NextTrigger 才能拿到 view=\"month\"（GOTO.NEXT=focusNextYear） -->\n      <CalendarNav view=\"month\" />\n      <ArkDatePicker.Context v-slot=\"context\">\n        <ArkDatePicker.Table :class=\"tableCls\">\n          <ArkDatePicker.TableBody>\n            <ArkDatePicker.TableRow\n              :class=\"rowCls\"\n              v-for=\"(monthsRow, id) in context.getMonthsGrid({ columns: 4, format: 'short' })\"\n              :key=\"id\"\n            >\n              <ArkDatePicker.TableCell\n                v-for=\"month in monthsRow\"\n                :key=\"month.value.toString()\"\n                :value=\"month.value\"\n                :class=\"bodyCellCls\"\n              >\n                <ArkDatePicker.TableCellTrigger :class=\"cn(cellCls)\">\n                  {{ month.label }}\n                </ArkDatePicker.TableCellTrigger>\n              </ArkDatePicker.TableCell>\n            </ArkDatePicker.TableRow>\n          </ArkDatePicker.TableBody>\n        </ArkDatePicker.Table>\n      </ArkDatePicker.Context>\n    </ArkDatePicker.View>\n\n    <ArkDatePicker.View v-else :view=\"'year'\">\n      <!-- 导航条必须在 View 子树内：Prev/NextTrigger 才能拿到 view=\"year\"（GOTO.NEXT=focusNextDecade） -->\n      <CalendarNav view=\"year\" />\n      <ArkDatePicker.Context v-slot=\"context\">\n        <ArkDatePicker.Table :class=\"tableCls\">\n          <ArkDatePicker.TableBody>\n            <ArkDatePicker.TableRow\n              :class=\"rowCls\"\n              v-for=\"(yearsRow, id) in context.getYearsGrid({ columns: 4 })\"\n              :key=\"id\"\n            >\n              <ArkDatePicker.TableCell\n                v-for=\"year in yearsRow\"\n                :key=\"year.value.toString()\"\n                :value=\"year.value\"\n                :class=\"bodyCellCls\"\n              >\n                <ArkDatePicker.TableCellTrigger :class=\"cn(cellCls)\">\n                  {{ year.label }}\n                </ArkDatePicker.TableCellTrigger>\n              </ArkDatePicker.TableCell>\n            </ArkDatePicker.TableRow>\n          </ArkDatePicker.TableBody>\n        </ArkDatePicker.Table>\n      </ArkDatePicker.Context>\n    </ArkDatePicker.View>\n  </div>\n</template>\n"
    },
    {
      "path": "calendar/CalendarNav.vue",
      "type": "registry:component",
      "target": "components/ui/calendar/CalendarNav.vue",
      "content": "<script setup lang=\"ts\">\nimport { DatePicker as ArkDatePicker } from \"@ark-ui/vue/date-picker\";\nimport type { PropType } from \"vue\";\n\n/**\n * 视图导航条（内部件）。必须渲染在 <ArkDatePicker.View> 子树内：\n * Prev/NextTrigger 的 view 参数由 View provide（ViewPropsContext），\n * 放在 View 外会落到默认 { view: \"day\" }，month/year 视图下\n * GOTO.NEXT 被 machine guard 的 event.view 短路成 focusNextPage（翻页月，表现为无反应）。\n */\nconst props = defineProps({\n  /** 导航条服务的视图，决定中间内容形态：day=ViewTrigger（上钻）/ month=年份 / year=年代 */\n  view: { type: String as PropType<\"day\" | \"month\" | \"year\">, required: true },\n});\n\nconst viewControlCls = \"flex items-center justify-between px-1 pb-3\";\nconst navBtnCls =\n  \"text-muted-foreground inline-flex size-8 items-center justify-center rounded-md outline-none hover:bg-accent disabled:cursor-not-allowed disabled:opacity-40\";\nconst viewTriggerCls =\n  \"hover:bg-accent inline-flex items-center gap-1 rounded-[3px] px-3 py-1.5 text-sm font-semibold text-foreground outline-none transition-colors disabled:pointer-events-none\";\nconst viewTitleCls = \"text-sm font-semibold text-foreground\";\n\n/** 年代范围文本（zag 无现成 part，由 focusedValue.year 推算）：2026 → \"2020 - 2029\" */\nfunction decadeRange(year: number | undefined): string {\n  const start = Math.floor((year ?? 0) / 10) * 10;\n  return `${start} - ${start + 9}`;\n}\n</script>\n\n<template>\n  <ArkDatePicker.ViewControl :class=\"viewControlCls\">\n    <ArkDatePicker.PrevTrigger :class=\"navBtnCls\">\n      <svg\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"size-4\"\n      >\n        <path d=\"m15 18-6-6 6-6\" />\n      </svg>\n    </ArkDatePicker.PrevTrigger>\n\n    <ArkDatePicker.Context v-slot=\"context\">\n      <!-- day：ViewTrigger 上钻钮（内容原样自 CalendarBody 迁入，视觉零回归） -->\n      <ArkDatePicker.ViewTrigger v-if=\"props.view === 'day'\" :class=\"viewTriggerCls\">\n        <ArkDatePicker.RangeText />\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          class=\"size-3.5 opacity-50\"\n        >\n          <path d=\"m7 15 5 5 5-5\" />\n          <path d=\"m7 9 5-5 5 5\" />\n        </svg>\n      </ArkDatePicker.ViewTrigger>\n      <!-- month：年份标题（ViewTrigger 承载——DatePicker 可上钻 year；\n           锁定组件下 zag getNextView 无下级 → 原生 disabled，点击钳制） -->\n      <ArkDatePicker.ViewTrigger v-else-if=\"props.view === 'month'\" :class=\"viewTriggerCls\">\n        {{ context.focusedValue?.year }}\n      </ArkDatePicker.ViewTrigger>\n      <!-- year：年代范围 -->\n      <span v-else :class=\"viewTitleCls\">{{ decadeRange(context.focusedValue?.year) }}</span>\n    </ArkDatePicker.Context>\n\n    <ArkDatePicker.NextTrigger :class=\"navBtnCls\">\n      <svg\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        class=\"size-4\"\n      >\n        <path d=\"m9 18 6-6-6-6\" />\n      </svg>\n    </ArkDatePicker.NextTrigger>\n  </ArkDatePicker.ViewControl>\n</template>\n"
    },
    {
      "path": "calendar/index.ts",
      "type": "registry:component",
      "target": "components/ui/calendar/index.ts",
      "content": "export { default as Calendar } from \"./Calendar.vue\";\n"
    }
  ]
}
